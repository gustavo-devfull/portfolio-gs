# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890

# FTP Configuration (for serverless function)
VITE_FTP_HOST=ftp.yourserver.com
VITE_FTP_USER=your_ftp_user
VITE_FTP_PASS=your_ftp_password
VITE_FTP_BASE_PATH=/public_html/portfolio/images
VITE_FTP_BASE_URL=https://yourserver.com/portfolio/images

# Upload Endpoint (Netlify or Vercel function)
VITE_UPLOAD_ENDPOINT=/.netlify/functions/upload-ftp
